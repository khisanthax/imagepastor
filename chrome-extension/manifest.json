{
  "manifest_version": 3,
  "name": "ImagePastor ChatGPT Completion Chime",
  "version": "1.0.2",
  "description": "Plays a local chime when a ChatGPT response finishes.",
  "minimum_chrome_version": "109",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ImagePastor completion chime",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "detector-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
